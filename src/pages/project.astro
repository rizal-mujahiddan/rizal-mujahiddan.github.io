---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/layout/NavBar";
import FooterCustom from "../components/layout/FooterCustom";
import ProjectCarousel from "../components/ui/ProjectCarousel";
---

<Layout title="Projects – Rizal Mujahiddan">
  <div class="min-h-screen bg-background text-foreground">
    <NavBar client:load />
    <div class="max-w-screen-2xl mx-auto px-8 py-12">
      <main
        class="
          flex
          flex-col
          items-center
          justify-between
          gap-16
          bg-card
          border
          border-border
          rounded-3xl
          px-16
          py-8
          shadow-sm
        "
      >
        <section>
          <h2 class="text-3xl">Projects</h2>
        </section>
        <section class="w-full">
          <ProjectCarousel client:load />
        </section>
      </main>
    </div>
    <FooterCustom client:load />
  </div>
</Layout>

