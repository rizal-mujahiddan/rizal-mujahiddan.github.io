---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/layout/NavBar";
import FooterCustom from "../components/layout/FooterCustom";
import { SkillsTutorial } from "../components/skills/SkillsTutorial";
---

<Layout title="Skills – Rizal Mujahiddan">
  <div class="min-h-screen bg-background text-foreground">
    <NavBar client:load />
    <div class="max-w-screen-2xl mx-auto px-8 py-12">
      <main>
        <article class="flex items-center justify-center content-between w-screen">
          <SkillsTutorial client:load />
        </article>
      </main>
    </div>
    <FooterCustom client:load />
  </div>
</Layout>

